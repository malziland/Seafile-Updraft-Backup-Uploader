# EditorConfig — https://editorconfig.org
# Matches the WordPress Coding Standards enforced by phpcs.xml.dist.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = tab

[*.{js,css}]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
# Trailing double-spaces are hard line breaks in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2
